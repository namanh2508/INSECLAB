# Optional live LLM judge validation.
# Copy this file to .env locally and fill in real values.
# Never commit .env.

# Set to 1 only when you intentionally want to run live LLM tests.
RUN_LIVE_LLM_TESTS=0

# API key for your OpenAI-compatible provider.
# Examples:
# - OpenAI: OPENAI_API_KEY
# - OpenRouter: OPENROUTER_API_KEY
# - Groq: GROQ_API_KEY
#
# The current live test reads OPENAI_API_KEY by default.
# If you use another env var name, export it manually or update the shell command accordingly.
OPENAI_API_KEY=

# OpenAI-compatible model name.
# Examples:
# - gpt-4o-mini
# - openai/gpt-4o-mini
# - llama-3.1-8b-instant
OPENAI_COMPATIBLE_MODEL=

# OpenAI-compatible base URL.
# Examples:
# - https://api.openai.com/v1
# - https://openrouter.ai/api/v1
# - https://api.groq.com/openai/v1
# - http://localhost:1234/v1
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1

# Response format mode:
# - json_object: broadly compatible default
# - json_schema: stronger where supported
# - none: use when provider rejects response_format
OPENAI_COMPATIBLE_RESPONSE_FORMAT=json_object
